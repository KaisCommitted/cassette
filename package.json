{
  "name": "cassette",
  "version": "0.1.0",
  "description": "A local media library and player for Windows. Your own files, with the browsing of a streaming app and the playback of VLC.",
  "main": "out/main/index.js",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.kaislamine.cassette",
    "productName": "Cassette",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/mpv",
        "to": "mpv"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KaisCommitted/cassette.git"
  },
  "author": "Kais Lamine"
}
